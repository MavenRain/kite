; test/dune:  parse.exe of Stage A (D-A-16), check.exe of Stage B
; (brief 3.13, D-B-18), iface.exe of Stage B (brief 3.9, D-B-14), and
; regress.exe for the semantic cases found during Stage B review.
; One stanza names all four executables.
; The executables read the four libraries of the tree and nothing else.
; kite_iface is WRAPPED, so test/iface.ml, whose own module is Iface,
; reads the library module as Kite_iface.Iface (D-B-65).
; -warn-error +a makes a warning an error (D-A-2).

(executables
 (names parse check iface regress)
 (modules parse check iface regress)
 (libraries kite_core kite_surface kite_elab kite_iface)
 (flags (:standard -warn-error +a)))

(executables
 (names cluster kubelet eval_test)
 (modules cluster kubelet eval_test runtime_suite)
 (libraries kite_runtime kite_execution kite_artifact kite_core kite_surface kite_elab)
 (flags (:standard -warn-error +a)))

(rule
 (alias runtest)
 (action
  (progn
   (run %{exe:cluster.exe})
   (run %{exe:kubelet.exe})
   (run %{exe:eval_test.exe}))))
