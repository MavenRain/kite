(* --- 7  variants and the pattern forms ----------------------- *)

(* A variant literal and a match over the five pattern forms:  an
   injection, a name, a literal, a wildcard and a record. *)
let tagged_01 = < ok 1 >
let failed_01 = < err "tab-1" >
let on_tag_01 = fun v -> match v with | < ok a > -> a | < err b > -> b
let read_ok_01 = on_tag_01 tagged_01
let read_err_01 = on_tag_01 failed_01
let on_lit_01 = fun n -> match n with | 1 -> "seen" | other -> "more"
let seen_01 = on_lit_01 1
let on_wild_01 = fun k -> match k with | _ -> 1
let any_01 = on_wild_01 true
let on_rec_01 = fun p -> match p with | { key = u | rest } -> u
let got_01 = on_rec_01 { key = 1 , size = 1 }

