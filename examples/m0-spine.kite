(* --- 6  scoped labels ---------------------------------------- *)

(* A duplicate label with occurrence indices.  Selection reads
   the FIRST occurrence and restriction removes it. *)
let twice_01 = { slot = 1 , slot = "slot-1" }
let first_01 = twice_01.slot
let after_01 = { twice_01 - slot }
let second_01 = after_01.slot

(* A duplicate label with occurrence indices.  Selection reads
   the FIRST occurrence and restriction removes it. *)
