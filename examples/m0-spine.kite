(* --- 4  the record forms ------------------------------------- *)

(* The record forms:  a literal, an extension, a restriction, a
   selection and a record annotation. *)
let row_01 = { key = "k-1" , size = 1 }
let wide_01 = { live = true | row_01 }
let narrow_01 = { wide_01 - size }
let key_01 = row_01.key
let size_01 = row_01.size
let live_01 = wide_01.live
let typed_01 = ({ key = "k-1" , size = 1 } : { key : Str , size : Int })
let grown_01 = { stamp = 1 | typed_01 }

