(* --- 10  protocols and roles --------------------------------- *)

(* A protocol whose every state declares the compensation the
   reaper runs on lock loss, and a role that answers every leg,
   the Peer_lost leg and the abort leg. *)
let undo_01 = 1
let redo_01 = 2
protocol Lease01 {
  state Idle { take : Int -> Busy } compensate undo_01
  state Busy { drop : Str -> Idle } compensate redo_01
}
role Holder01 : Lease01 {
  take a -> a,
  drop b -> b,
  Peer_lost -> 1,
  abort -> 2
}

(* A protocol whose every state declares the compensation the
   reaper runs on lock loss, and a role that answers every leg,
   the Peer_lost leg and the abort leg. *)
