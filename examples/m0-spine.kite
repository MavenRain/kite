(* examples/m0-spine.kite:  the frozen 1 kloc numerator corpus of
   GATE M0 (D-M0-3, D-B-21).  It is ONE program:  a session store
   for a tab cluster, written so that every M0 form of
   surface/ast.ml appears and every declaration checks clean.

   The affine section holds more than twenty -1> binders, so the
   mutant that empties the use count pass has a corpus to die on
   (M0-PLAN.md:109).  No M1 to M4 form appears here, because the
   checker refuses each one with NotYet. *)

(* --- 1  the literal kinds and the fourteen operators --------- *)

let unit_value = ()
let true_flag = true
let false_flag = false
let zero_count = 0
let store_name = "session-store"
let sum_of = 1 + 2
let rest_of = 9 - 4
let product_of = 3 * 5
let share_of = 12 / 4
let remainder_of = 13 % 4
let joined_name = "tab" ^ "-" ^ "store"
let same_as = 1 == 1
let other_than = 1 != 2
let under = 1 < 2
let under_or_same = 2 <= 2
let over = 3 > 2
let over_or_same = 3 >= 3
let both_hold = true && true
let one_holds = false || true

(* --- 2  lambdas, application and the if form ----------------- *)

(* Arithmetic over the tab index 1. *)
let step_01 = fun n -> n + 1
let back_01 = fun n -> n - 1
let scale_01 = fun n -> n * 2
let split_01 = fun n -> n / 2
let wrap_01 = fun n -> n % 3
let mix_01 = fun m n -> step_01 m + back_01 n
let ranked_01 = mix_01 1 4
let named_01 = "tab-" ^ store_name
let gated_01 = if ranked_01 > 1 then ranked_01 else 1

