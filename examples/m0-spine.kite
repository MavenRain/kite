(* --- 8  the at most once arrows of the use count pass -------- *)

(* An at most once arrow.  The binder carries the -1> bit and it
   is used exactly one time, so the use count pass reads Once. *)
let lease_01 = (fun n -> n + 1 : Int -1> Int)
let held_lease_01 = lease_01 1

(* An at most once arrow.  The binder carries the -1> bit and it
   is used exactly one time, so the use count pass reads Once. *)
let lease_02 = (fun n -> n + 2 : Int -1> Int)
