(* --- 5  open rows -------------------------------------------- *)

(* One open row read at two different label sets. *)
let read_key_01 = fun r -> r.key
let from_small_01 = read_key_01 { key = 1 , size = 1 }
let from_wide_01 = read_key_01 { key = "k" , live = true , size = 1 }
let read_two_01 = fun r -> { key = r.key , size = r.size }
let taken_01 = read_two_01 { key = "k" , size = 1 , extra = () }

