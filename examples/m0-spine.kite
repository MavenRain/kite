(* --- 14  recursive groups ------------------------------------ *)

(* A recursive group.  The group generalizes together, so both
   names leave the group at one scheme. *)
let rec even_01 = fun n -> if n == 0 then true else odd_01 (n - 1)
and odd_01 = fun n -> if n == 0 then false else even_01 (n - 1)
let is_even_01 = even_01 2
let is_odd_01 = odd_01 3

