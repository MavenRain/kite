(* --- 3  generalization and the value restriction ------------- *)

(* A generalized let used at two instances, and one right hand
   side that is not a value and therefore stays monomorphic. *)
let same_01 = fun x -> x
let count_01 = same_01 1
let label_01 = same_01 "row-1"
let held_01 = same_01 (fun z -> z)
let pair_01 = let inner = fun y -> y in { left = inner 1 , right = inner true }

