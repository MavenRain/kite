(* --- 15  the pipeline the lowering pass erases --------------- *)

(* A nested let, an if over a comparison and a chain of three
   applications, which is the shape the lowering pass erases. *)
let apply_01 = fun f x -> f x
let twice_apply_01 = fun f x -> f (f x)
let chain_01 = let base = fun n -> n + 1 in twice_apply_01 base 1
let route_01 = if chain_01 >= 1 then "high" else "low"
let folded_01 = apply_01 (fun n -> n * 2) chain_01
let report_01 = { route = route_01 , folded = folded_01 }

